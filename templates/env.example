# ==============================================================================
# Wiz Tenant Health Assessment & Executive Presentation Deck Builder
# Environment Configuration Template
# ------------------------------------------------------------------------------
# 1. Find your datacenter at: https://app.wiz.io/tenant-info/data-center-and-regions
# 2. Create Service Account at: https://app.wiz.io/settings/service-accounts/new
#    Type: </> Custom Integration (GraphQL API) | Scope: Read all entities (read:all)
# ------------------------------------------------------------------------------
# Copy this file to .env and fill in your service account credentials.
# NEVER commit the filled .env file to version control.
# ==============================================================================

# Wiz Authentication OAuth Endpoint (default: https://auth.wiz.io/oauth/token)
WIZ_AUTH_URL=https://auth.wiz.io/oauth/token

# Wiz Data Center Identifier (e.g. us1, us2, us20, us100, eu1, gov)
WIZ_DATACENTER=us1

# Direct Wiz GraphQL API Endpoint (constructed as: https://api.${WIZ_DATACENTER}.app.wiz.io/graphql)
WIZ_API_ENDPOINT=https://api.us1.app.wiz.io/graphql

# Wiz Service Account Credentials
WIZ_CLIENT_ID=your_wiz_service_account_client_id_here
WIZ_CLIENT_SECRET=your_wiz_service_account_client_secret_here

# ------------------------------------------------------------------------------
# Google Slides & Drive Configuration (Optional - only if generating Google Slides)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
QBR_TEMPLATE_ID=1ga4sflsBPZS2lsXi6k6fUY1jU5dOrqQ9bQ1JEp3B5GM
GOOGLE_FOLDER_ID=your_google_drive_folder_id_here
