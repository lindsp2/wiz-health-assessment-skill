# ==============================================================================
# Wiz Tenant Health Assessment & Executive Presentation Deck Builder
# Environment Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to .env and fill in your service account credentials.
# NEVER commit the filled .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Wiz API Configuration (Required)
# ------------------------------------------------------------------------------
# Wiz Authentication OAuth Endpoint (default: https://auth.wiz.io/oauth/token)
WIZ_AUTH_URL=https://auth.wiz.io/oauth/token

# Wiz Data Center / Region Identifier (e.g., us1, us2, us20, us100, eu1, gov)
WIZ_DATACENTER=us1

# Direct Wiz GraphQL API Endpoint
# Constructed as: https://api.${WIZ_DATACENTER}.app.wiz.io/graphql
WIZ_API_ENDPOINT=https://api.us1.app.wiz.io/graphql

# Wiz Service Account Credentials (from Settings > Service Accounts in Wiz Portal)
# Required scope: read:all
WIZ_CLIENT_ID=your_wiz_service_account_client_id_here
WIZ_CLIENT_SECRET=your_wiz_service_account_client_secret_here

# ------------------------------------------------------------------------------
# 2. Google Slides & Drive Configuration (Optional / For Slides Generation)
# ------------------------------------------------------------------------------
# Google Cloud OAuth 2.0 Client Credentials (with Drive & Slides API scopes enabled)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# Master Presentation Template ID (Google Slides file ID)
# Default master template ID: 1ga4sflsBPZS2lsXi6k6fUY1jU5dOrqQ9bQ1JEp3B5GM
QBR_TEMPLATE_ID=1ga4sflsBPZS2lsXi6k6fUY1jU5dOrqQ9bQ1JEp3B5GM

# Target Google Drive Folder ID to store generated presentations (Optional)
GOOGLE_FOLDER_ID=your_google_drive_folder_id_here
