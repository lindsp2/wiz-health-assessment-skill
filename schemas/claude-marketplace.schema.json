{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude Code marketplace",
  "type": "object",
  "required": ["name", "version", "description", "owner", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$" },
    "description": { "type": "string", "minLength": 10 },
    "owner": { "$ref": "#/definitions/party" },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source": { "type": "string" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$" },
          "description": { "type": "string", "minLength": 10 },
          "category": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "author": { "$ref": "#/definitions/party" }
        }
      }
    }
  },
  "definitions": {
    "party": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
